{
  "manifest_version": 3,
  "name": "TrueTrophies Data Extractor (Debug)",
  "version": "1.0",
  "description": "Extract trophy data from TrueTrophies pages and export to CSV - Debug Version",
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.truetrophies.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract Trophy Data (Debug)"
  },
  "content_scripts": [
    {
      "matches": ["https://www.truetrophies.com/game/*/trophies*"],
      "js": ["content-debug.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
